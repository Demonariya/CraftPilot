{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CraftPilot",
  "version": "1.6.0",
  "identifier": "com.demonariya.craftpilot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CraftPilot",
        "width": 1440,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "backgroundColor": "#111315"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Game",
    "shortDescription": "Minecraft Server Manager",
    "longDescription": "A modern Windows-first Minecraft server manager.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}
